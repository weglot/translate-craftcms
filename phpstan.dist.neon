includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/tomasvotruba/type-coverage/config/extension.neon

parameters:
    level: 6
    tmpDir: .cache/phpstan

    # The scoped Weglot library and the selector-registration events both describe
    # their data in PHPDoc only, and neither promise is enforced at runtime. Treating
    # those types as certain made PHPStan report the defensive guards against that
    # data as redundant.
    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        # Url::getForLanguage() declares no native param types, and PHP forbids
        # narrowing a parameter in a subclass, so this stub cannot be typed without
        # a fatal error. Scoped vendor code is generated and must not be edited.
        -
            identifier: typeCoverage.paramTypeCoverage
            path: tests/unit/services/ReplaceLinkServiceTest.php

    scanFiles:
        - vendor/craftcms/cms/src/Craft.php
        - vendor/yiisoft/yii2/Yii.php

    paths:
        - src
        - tests
    excludePaths:
        - src/vendor
        # Craft's runtime dir: a failing test renders an error page, which compiles
        # Twig templates in here. PHPStan does not read .gitignore and would analyse
        # that generated code.
        - tests/_craft
    stubFiles:
        - phpstan/stubs/yii/BaseYii.stub
        - phpstan/stubs/craft/console/Application.stub
        - phpstan/stubs/craft/web/Application.stub

    strictRules:
        strictArrayFilter: false

    type_coverage:
        return: 100
        param: 100
        property: 100
        constant: 0 # Require PHP 8.3
